<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:padding="16dp"
    android:orientation="vertical"
    tools:context=".HomeActivity">

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btnLogout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="80dp">

            <!-- Location Info -->
            <TextView
                android:id="@+id/tvLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fetching_Location"
                android:textSize="18sp"
                android:textColor="#003366"
                android:textStyle="bold"
                android:layout_marginBottom="24dp" />

            <!-- Hotels Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <Button
                    android:id="@+id/btnHotels"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hotels_Nearby"
                    android:drawableLeft="@drawable/ic_hotel"
                    android:padding="16dp"
                    android:textSize="16sp"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#003366"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    tools:ignore="RtlHardcoded" />
            </androidx.cardview.widget.CardView>

            <!-- Hospitals Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <Button
                    android:id="@+id/btnHospitals"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#003366"
                    android:drawableLeft="@drawable/ic_hospital"
                    android:padding="16dp"
                    android:text="@string/hospitals_Nearby"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    tools:ignore="RtlHardcoded,TextContrastCheck" />
            </androidx.cardview.widget.CardView>

            <!-- Banks Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <Button
                    android:id="@+id/btnBanks"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#003366"
                    android:drawableLeft="@drawable/ic_bank"
                    android:padding="16dp"
                    android:text="@string/banks_Atms_Nearby"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    tools:ignore="RtlHardcoded,TextContrastCheck" />
            </androidx.cardview.widget.CardView>

            <!-- Tourist Attractions Button -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp">

                <Button
                    android:id="@+id/btnTourist"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#003366"
                    android:drawableLeft="@drawable/ic_tour"
                    android:padding="16dp"
                    android:text="@string/tourist_Attractions"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    app:cornerRadius="12dp"
                    tools:ignore="RtlHardcoded,TextContrastCheck" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>

    <!-- Logout button fixed at bottom -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#003366"
        app:cornerRadius="12dp"
        android:layout_alignParentBottom="true"
        android:layout_margin="8dp"
        tools:ignore="HardcodedText" />
</RelativeLayout>
